{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/governance-hooks/session-start-codex.mjs\"",
            "timeout": 30,
            "statusMessage": "读取治理状态"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command|apply_patch|Edit|Write|MultiEdit|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/governance-hooks/pre-tool-use-codex.mjs\"",
            "timeout": 30,
            "statusMessage": "检查治理策略"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/governance-hooks/stop.mjs\"",
            "timeout": 120,
            "statusMessage": "运行收尾验证"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/governance-hooks/pre-compact-codex.mjs\"",
            "timeout": 30,
            "statusMessage": "压缩前检查坐标"
          }
        ]
      }
    ]
  }
}
