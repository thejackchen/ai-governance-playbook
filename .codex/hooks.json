{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/governance.mjs\" session-start --runtime codex",
            "timeout": 10
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/governance.mjs\" pre-tool --runtime codex",
            "timeout": 10
          }
        ],
        "matcher": "Bash|run_terminal_command|exec_command|apply_patch|Edit|Write|MultiEdit|search_replace"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/governance.mjs\" stop --runtime codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
