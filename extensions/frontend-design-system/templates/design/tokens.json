{
  "schemaVersion": 1,
  "primitive": {
    "color": {
      "background": "{{COLOR_BACKGROUND}}",
      "surface": "{{COLOR_SURFACE}}",
      "text": "{{COLOR_TEXT}}",
      "primary": "{{COLOR_PRIMARY}}",
      "danger": "{{COLOR_DANGER}}"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px"
    },
    "radius": {
      "control": "6px",
      "panel": "8px"
    },
    "type": {
      "body": "16px",
      "label": "14px",
      "title": "24px"
    },
    "motion": {
      "fast": "120ms",
      "standard": "200ms"
    }
  },
  "semantic": {
    "color": {
      "canvas": "{primitive.color.background}",
      "surface": "{primitive.color.surface}",
      "content": "{primitive.color.text}",
      "accent": "{primitive.color.primary}",
      "negative": "{primitive.color.danger}"
    },
    "space": {
      "contentGap": "{primitive.space.3}",
      "controlGap": "{primitive.space.2}",
      "sectionGap": "{primitive.space.4}"
    },
    "radius": {
      "control": "{primitive.radius.control}",
      "panel": "{primitive.radius.panel}"
    },
    "type": {
      "body": "{primitive.type.body}",
      "label": "{primitive.type.label}",
      "title": "{primitive.type.title}"
    }
  },
  "component": {
    "button": {
      "background": "{semantic.color.accent}",
      "gap": "{semantic.space.controlGap}",
      "radius": "{semantic.radius.control}",
      "labelSize": "{semantic.type.label}"
    },
    "field": {
      "background": "{semantic.color.surface}",
      "content": "{semantic.color.content}",
      "gap": "{semantic.space.controlGap}",
      "radius": "{semantic.radius.control}"
    },
    "surface": {
      "background": "{semantic.color.surface}",
      "padding": "{semantic.space.contentGap}",
      "radius": "{semantic.radius.panel}"
    }
  }
}
